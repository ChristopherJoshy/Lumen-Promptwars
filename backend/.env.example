# Copy to backend/.env (never commit the real one)
APP_NAME=Lumen
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000
APP_ENV=dev
# MongoDB usage ledger; empty disables it (local-first, never required)
MONGO_URL=
# S3-compatible; local dev falls back to ./storage shim when unset
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=lumen-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# WhatsApp (Twilio sandbox for dev)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
# Fact-check + LLM
GOOGLE_FACT_CHECK_API_KEY=
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
MUSE_MODEL=muse-spark-1.3-contributor-free
EXA_API_KEY=
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=saaras:v3
AGENT_TIMEOUT_S=20
LLM_API_KEY=
LLM_MODEL=
FRONTEND_URL=http://localhost:3000
