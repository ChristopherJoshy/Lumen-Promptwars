# Lumen env — copy to backend/.env locally, or paste key-by-key into Render.
# RENDER: set every non-empty value below; generate nothing (keys already issued).
APP_NAME=Lumen
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000
# Postgres in Docker/Render; empty -> local SQLite fallback
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
# MongoDB usage ledger (Atlas); empty disables it
MONGO_URL=
# S3-compatible; empty -> ./storage shim
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=lumen-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# WhatsApp (Twilio sandbox for dev; same keys on Render)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_WEBHOOK_URL=https://lumen-promptwars.onrender.com/api/v1/whatsapp/webhook
# Fact-check + LLM (RENDER: paste the three API keys here)
GOOGLE_FACT_CHECK_API_KEY=
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
MUSE_MODEL=muse-spark-1.3-contributor-free
EXA_API_KEY=
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=saaras:v3
AGENT_TIMEOUT_S=20
AGENT_MAX_FRAMES=6
AGENT_MAX_AUDIO_MB=12
AGENT_MAX_AUDIO_S=180
LLM_API_KEY=
LLM_MODEL=
# Public web origins (RENDER: keep as-is)
FRONTEND_URL=https://lumen-promptwars.vercel.app
CORS_ORIGINS=http://localhost:3000,https://lumen-promptwars.vercel.app
